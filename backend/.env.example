# backend/.env.example
#
# SQLite 数据库文件路径。
#
# Prisma 的 file: 相对路径解析规则：
#   - CLI (migrate / generate / db push / seed via CLI) → 相对 prisma/schema.prisma 所在目录
#   - Runtime (PrismaClient via backend/src/prisma/prisma.service.ts) → 相对 backend/
# backend/src/prisma/prisma.service.ts 内部已统一为 schema 目录解析，
# 所以这里的 file:./dev.db 在 CLI 和 runtime 下都会落到 backend/prisma/dev.db。
#
DATABASE_URL="file:./dev.db"

# 后端服务端口
PORT=3000

# ============================================================================
# JWT 认证（PR 4 新增）
# ----------------------------------------------------------------------------
# JWT_SECRET：签名密钥。**生产环境必须**改用环境变量注入的强随机字符串（≥32 字节）。
# JWT_EXPIRES_IN：访问令牌有效期。默认 24h（开发期）；生产建议 1h + 配 refresh token。
# DEV_TOKEN_USER_ID：/api/auth/dev-token 默认签发的 userId。
#   仅开发环境用 —— 生产环境应禁掉 dev-token 端点（设 NODE_ENV=production）。
# ============================================================================
JWT_SECRET=dev-only-change-me-in-production-please-use-a-real-secret
JWT_EXPIRES_IN=24h
DEV_TOKEN_USER_ID=demo-user

# ============================================================================
# CORS（PR 6 新增）
# ----------------------------------------------------------------------------
# ALLOWED_ORIGINS：CORS 白名单（逗号分隔）
#   开发环境默认 http://localhost:3001（前端 dev 端口）
#   生产环境必须改成实际前端域名
#   多环境示例：https://yoyu.example.com,https://staging.yoyu.example.com
#
# 与之前对比：
#   之前 cors: true → Access-Control-Allow-Origin: *（任何网站都能调）
#   现在 cors: { origin: [白名单] } → 只允许列表中的 origin
# ============================================================================
ALLOWED_ORIGINS=http://localhost:3001

# （后续可能用到，先留位）
# NODE_ENV=development
# LOG_LEVEL=debug
